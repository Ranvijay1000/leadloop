# Local server settings
PORT=4173
HOST=127.0.0.1
LEADLOOP_DB=./data/leadloop.sqlite

# For a TLS-terminated deployment, use NODE_ENV=production, bind to the
# trusted host selected by your platform, and set PUBLIC_ORIGIN to the exact
# public origin (for example https://crm.example.com). The included server is
# a development prototype and is not production hardened.
NODE_ENV=development
PUBLIC_ORIGIN=

# Reserved placeholders for server-side provider adapters. The current app
# does not use these integrations; never put their values in browser code.
OPENAI_API_KEY=
EMAIL_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_TOKEN=
CALLING_PROVIDER_API_KEY=
GOOGLE_CALENDAR_CLIENT_SECRET=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
META_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
PUBLIC_FORM_SIGNING_SECRET=
